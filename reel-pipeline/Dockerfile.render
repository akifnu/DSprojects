FROM ubuntu:24.04

ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg python3 python3-pil ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/reel-pipeline
COPY scripts/fast_render.py scripts/fast_render.py
ENTRYPOINT ["python3", "scripts/fast_render.py"]
